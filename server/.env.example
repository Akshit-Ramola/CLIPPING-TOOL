# --- Server ---
PORT=5000
# Bind to localhost only: this API starts FFmpeg/yt-dlp processes and has no login.
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/gta-face-clipper

# --- Stream discovery + YouTube live chat ---
YOUTUBE_API_KEY=

# --- Twitch live chat (optional) ---
TWITCH_CHAT_USERNAME=
TWITCH_CHAT_TOKEN=

# --- Zernio scheduling (optional) ---
ZERNIO_API_KEY=
ZERNIO_YOUTUBE_ACCOUNT_ID=
ZERNIO_INSTAGRAM_ACCOUNT_ID=
GTA_UNATTENDED_POSTS=0

# --- Tool paths (leave empty to use the bundled ffmpeg-static / ffprobe-static and server/bin/yt-dlp) ---
FFMPEG_PATH=
FFPROBE_PATH=
YTDLP_PATH=

# --- Speech recognition (transformers.js Whisper, downloaded on first use) ---
WHISPER_MODEL=onnx-community/whisper-base_timestamped
WHISPER_EN_MODEL=onnx-community/whisper-base_timestamped

# --- Player tracking for the "fill" layout (downloads a 35 MB YOLOX model on first use) ---
ENABLE_PLAYER_TRACKING=1
