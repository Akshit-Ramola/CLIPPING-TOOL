{
  "name": "gta-face-clipper-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB API for GTA Face Clipper: live stream discovery, highlight clipping, vertical rendering and Zernio scheduling.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup:ytdlp": "node scripts/download-ytdlp.js",
    "setup:models": "node scripts/download-models.js",
    "check": "node scripts/check-tools.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.3.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "onnxruntime-node": "1.21.0",
    "zod": "^3.24.1"
  }
}
